# Copy into .env.local (never committed) and into the Vercel environment variables.

# MongoDB Atlas connection string (free cluster, EU region) for the online save
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Secret sent by Vercel to the daily cron: /api/keepalive refuses any call without it
CRON_SECRET=a-long-random-string
